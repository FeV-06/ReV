{
  "name": "rev-handover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3077",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3077",
    "typecheck": "tsc --noEmit",
    "contracts:generate": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/contracts.ts",
    "contracts:check": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/contracts.ts --check",
    "daemon:build": "node scripts/build-daemon.mjs",
    "daemon:start": "node dist/daemon/entry.js",
    "daemon:autostart": "node scripts/daemon-autostart.mjs",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp:start": "node dist/mcp/index.js",
    "vscode:build": "node editors/vscode/esbuild.js",
    "test": "cargo build --workspace && pnpm daemon:build && pnpm vscode:build && vitest run",
    "test:rust": "cargo test --workspace",
    "verify": "pnpm typecheck && pnpm contracts:check && pnpm test && pnpm test:rust && pnpm build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.27.4",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  }
}
