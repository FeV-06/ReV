# Optional model configuration. Keep actual values in .env.local, never commit it.
# REV_MODEL_PROVIDER=openai
# REV_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# REV_MODEL_NAME=your-model
# REV_MODEL_API_KEY=
# Optional read-only token for private GitHub repositories.
# REV_GITHUB_TOKEN=
# REV_DATA_DIR=.rev-data

# Optional checkout to read instead of the ReV app's working directory.
# REV_GIT_DIR=/absolute/path/to/project
# Optional live Slack import. Invite the Slack app to each configured channel.
# REV_SLACK_BOT_TOKEN=
# REV_SLACK_CHANNEL_IDS=C0123456789
# Slack sign-in and channel picker. Enable PKCE on the Slack app.
# REV_SLACK_CLIENT_ID=
